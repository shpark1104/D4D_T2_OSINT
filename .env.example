PORT=3000

# StealthMole External API
STEALTHMOLE_BASE_URL=https://hackathon.stealthmole.com
STEALTHMOLE_ACCESS_KEY=
STEALTHMOLE_SECRET_KEY=

# true면 실제 API 대신 샘플 응답을 반환합니다.
# 키가 비어 있어도 자동으로 mock 모드가 켜집니다.
STEALTHMOLE_MOCK=true

# LLM 연동 (OpenAI API). 비어 있으면 LLM 단계는 자동으로 비활성화(스킵)됩니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Wallet Intel submodule
# Default is mock. Set false for live provider calls.
WALLET_INTEL_MOCK=true
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_CHAIN_ID=1
BLOCKCHAIN_COM_BASE_URL=https://blockchain.info
WALLET_INTEL_MAX_DEPTH=3
WALLET_INTEL_TX_LIMIT=25
WALLET_INTEL_MAX_FANOUT=8
WALLET_INTEL_MAX_NODES=80
